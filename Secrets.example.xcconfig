// Benchd — secret build settings.
//
// SETUP: copy this file to Secrets.xcconfig (same directory) and fill in the real
// values from your Supabase project dashboard → Project Settings → API.
//
//     cp Secrets.example.xcconfig Secrets.xcconfig
//
// Secrets.xcconfig is gitignored. This example file is committed.
//
// ─────────────────────────────────────────────────────────────────────────────
// IMPORTANT — the "//" problem
//
// In an .xcconfig file, "//" starts a comment ANYWHERE on the line, including
// inside a value. Writing the URL the obvious way:
//
//     SUPABASE_URL = https://abcdefgh.supabase.co     <- BROKEN
//
// silently truncates the value to "https:" and throws the rest away.
//
// The fix is to break up the slashes with $() — an empty variable reference that
// expands to nothing, so the build setting resolves back to the full URL:
//
//     SUPABASE_URL = https:/$()/abcdefgh.supabase.co  <- CORRECT
//
// Keep the $() when you paste in your own project ref.
// ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co

// The anon / publishable key. Safe to ship in a client — it is only useful in
// combination with Row Level Security, so every table must have RLS enabled.
// Never put the service_role key here.
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY
